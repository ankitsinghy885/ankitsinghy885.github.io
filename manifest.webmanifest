{
  "name": "Expense Tracker",
  "short_name": "Expenses",
  "description": "Track daily expenses against a monthly budget, with a recommended daily spending limit. Works offline, data stays on your device.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#e9f0fb",
  "theme_color": "#e9f0fb",
  "lang": "en",
  "dir": "ltr",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "store/screenshots/01-dashboard.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Today's spending and your daily limit" },
    { "src": "store/screenshots/02-charts.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Daily spending chart and category split" },
    { "src": "store/screenshots/03-add-expense.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Adding an expense takes seconds" },
    { "src": "store/screenshots/04-history.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "History grouped by day" },
    { "src": "store/screenshots/05-currencies.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Every country's currency" }
  ],
  "shortcuts": [
    {
      "name": "Add an expense",
      "short_name": "Add",
      "url": "/?action=add",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
